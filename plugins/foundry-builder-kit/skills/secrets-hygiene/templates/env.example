# .env.example: commit THIS file, never .env or .env.local.
# Copy it:  cp .env.example .env.local   then fill in real values locally.
# Every variable the app reads is listed here with an empty or fake value.

# Public values (safe in the browser bundle; still keep them out of git history if you can)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets (never prefix these with NEXT_PUBLIC_ or VITE_)
DATABASE_URL=
AUTH_SECRET=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
STRIPE_SECRET_KEY=
